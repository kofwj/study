name: Android APK
on:
  workflow_dispatch:
  push:
    paths:
      - 'android/**'
      - 'VERSION'
      - '.github/workflows/android-apk.yml'
permissions:
  contents: write
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: android-actions/setup-android@v3
      - run: sdkmanager --install "platforms;android-35" "build-tools;35.0.0"
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'
      - run: gradle assembleDebug
        working-directory: android
      - name: Publish to Releases
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          VER=$(tr -d ' \n' < VERSION)
          cp android/app/build/outputs/apk/debug/app-debug.apk sunshine.apk
          gh release view apk >/dev/null 2>&1 || gh release create apk --title "阳光学习 APK" --notes "平板安装包（debug 签名）。打开后访问 https://study.anemy.org/。允许安装未知来源。长按顶栏可改服务器地址。用法见 FAMILY.md。" --target "$GITHUB_SHA"
          gh release upload apk sunshine.apk --clobber
          echo "built $VER"
